{
  "name": "create-field-broadsheet",
  "version": "0.1.0",
  "description": "THE IRREGULAR — Field Edition. A dark computational-field personal site, authored in Markdown, compiled by Eleventy into one page.",
  "bin": {
    "create-field-broadsheet": "./cli.js"
  },
  "files": [
    "cli.js",
    "eleventy.config.js",
    "field.config.js",
    "vercel.json",
